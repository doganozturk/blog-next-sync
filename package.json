{
  "name": "@doganozturk/blog",
  "version": "0.1.0",
  "private": true,
  "description": "Doğan Öztürk's Personal Blog",
  "type": "module",
  "scripts": {
    "dev": "\"$npm_execpath\" --bun x next dev --turbo",
    "build": "\"$npm_execpath\" --bun x next build",
    "postbuild": "next-sitemap && next-image-export-optimizer",
    "start": "\"$npm_execpath\" --bun x next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "\"$npm_execpath\" test --watch",
    "test:ci": "\"$npm_execpath\" test",
    "test:coverage": "\"$npm_execpath\" test --coverage --coverage-reporter=lcov",
    "pagespeed": "\"$npm_execpath\" x --bun --no-install pagespeed --urls-file ./pagespeed.urls.txt --strategy=mobile",
    "pagespeed:generate-urls": "\"$npm_execpath\" run scripts/generate-pagespeed-urls.ts > pagespeed.urls.txt"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "16.3.5",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "date-fns": "^2.29.3",
    "gray-matter": "^4.0.3",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-pretty-code": "^0.14.5",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^3.23.0"
  },
  "browserslist": [
    "last 2 versions",
    "Safari >= 10",
    "iOS >= 10",
    "> 1%",
    "not dead"
  ],
  "devDependencies": {
    "@doganozturk/pagespeed-cli": "^1.0.5",
    "@happy-dom/global-registrator": "^20.14.5",
    "@next/eslint-plugin-next": "16.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "1.4.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-css-modules": "^1.0.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "next-image-export-optimizer": "^1.21.1",
    "next-sitemap": "^4.2.3",
    "typescript": "~6.0.3"
  }
}
